#mon-chip.idle{background:color-mix(in srgb,var(--ok) 12%,transparent);border-color:var(--ok);color:var(--ok)}
#mon-detail{font-size:.8rem;color:var(--muted);flex:1 1 auto;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#mon-who{font-size:.72rem;color:var(--dim);letter-spacing:.05em;flex:none;max-width:30ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#mon-prog{flex:0 1 200px;min-width:120px;height:6px;border-radius:4px;background:rgba(148,163,184,.16);overflow:hidden;align-self:center}
#mon-prog i{display:block;height:100%;width:0;border-radius:4px;background:var(--ac);transition:width .5s}
#mon{display:grid;gap:13px;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));align-items:stretch}
.tile{position:relative;border:1px solid var(--line);border-radius:16px;background:var(--card);
  backdrop-filter:blur(10px);padding:13px 15px 9px;overflow:hidden;transition:border-color .3s,transform .3s}
.tile:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--q) 40%,var(--line))}
.tile .lab{font-size:.66rem;letter-spacing:.14em;color:var(--muted)}
.tile .val{font-size:1.4rem;font-weight:700;font-variant-numeric:tabular-nums;line-height:1.15;margin-top:3px}
.tile .val small{font-size:.68rem;font-weight:500;color:var(--muted);margin-left:3px}
.tile{display:flex;flex-direction:column}
.tile .sub{font-size:.68rem;color:var(--muted);min-height:1em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tile svg{width:100%;height:34px;margin-top:auto;padding-top:8px;color:var(--ac,var(--q))}
.tile .pbar{margin-top:auto}
.tile .area{fill:currentColor;opacity:.12}
.tile .line{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}
.tile.alt{--ac:var(--s)}
.tile.ph .val,.tile.ph .val2{color:var(--dim)}
.pbar{height:6px;border-radius:4px;background:rgba(148,163,184,.16);overflow:hidden}
.pbar i{display:block;height:100%;width:0;border-radius:4px;background:var(--q);transition:width .6s}
.pbar.ram i{background:var(--read)}
.pbar.ram.hot i{background:var(--err)}
.pbar.warm i{background:var(--s)}
#mon-strip{margin:14px 2px 0;font-size:.75rem;color:var(--muted);line-height:1.7;min-height:3.4em}
#mon-strip b{color:var(--fg);font-weight:600;font-variant-numeric:tabular-nums}
.reqwrap{border:1px solid var(--line);border-radius:16px;background:var(--card);backdrop-filter:blur(10px);
  padding:8px 16px 12px;margin-top:16px;overflow-x:auto;transition:border-color .3s}
.reqwrap:hover{border-color:color-mix(in srgb,var(--q) 25%,var(--line))}
#mon-table{width:100%;border-collapse:collapse;font-size:.73rem}
#mon-table th{color:var(--dim);font-weight:500;text-align:right;padding:6px 8px;border-bottom:1px solid var(--line);
  font-size:.66rem;letter-spacing:.1em;white-space:nowrap}
#mon-table th:first-child,#mon-table th:nth-child(2){text-align:left}
#mon-table td{padding:6px 8px;text-align:right;border-bottom:1px solid rgba(148,163,184,.08);
  font-variant-numeric:tabular-nums;color:var(--fg);white-space:nowrap}
#mon-table td:first-child,#mon-table td:nth-child(2){text-align:left}
#mon-table tr{transition:background .3s}
#mon-table tr:hover td{background:rgba(148,163,184,.06)}
#mon-tb tr.phr td{color:var(--dim)}
.fin{font-size:.62rem;padding:.12rem .55rem;border-radius:999px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.fin.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 45%,var(--line))}
.fin.len{color:var(--q);border-color:color-mix(in srgb,var(--q) 45%,var(--line))}
.fin.err{color:var(--err);border-color:color-mix(in srgb,var(--err) 45%,var(--line))}
#mon-hint{font-size:.72rem;color:var(--dim);min-height:1.5em}

/* ---------------- settings ---------------- */
.seg{display:inline-flex;border:1px solid var(--line);border-radius:999px;padding:4px;gap:4px;
  background:var(--card);margin-bottom:16px}
.seg button{border:none;background:transparent;color:var(--muted);font:inherit;font-size:.78rem;
  padding:.42rem 1.1rem;border-radius:999px;cursor:pointer;transition:all .35s}
.seg button.on{background:linear-gradient(135deg,var(--q),var(--s));color:#05121f;font-weight:600}
html[data-theme=light] .seg button.on{color:#fff}
.panel{border:1px solid var(--line);border-radius:18px;background:var(--card);backdrop-filter:blur(12px);
  padding:18px 20px;margin-bottom:16px;transition:border-color .35s}
.panel:hover{border-color:color-mix(in srgb,var(--q) 30%,var(--line))}
.panel .ptitle{display:flex;align-items:center;gap:10px;font-size:.84rem;font-weight:600;margin-bottom:4px}
.panel .ptitle .tag{font-size:.6rem;letter-spacing:.18em;color:var(--dim)}
.panel .pnote{font-size:.72rem;color:var(--muted);line-height:1.6;margin:0 0 14px}
.fgrid{display:grid;gap:12px 18px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:.7rem;letter-spacing:.08em;color:var(--muted);display:flex;justify-content:space-between}
.field label output{color:var(--q);font-weight:600;font-variant-numeric:tabular-nums}
.field input[type=range]{accent-color:var(--q);width:100%}
.field select,.field input[type=text],.field input[type=number]{
  background:rgba(148,163,184,.08);border:1px solid var(--line);border-radius:9px;color:var(--fg);
  font:inherit;font-size:.8rem;padding:.42rem .6rem;transition:border-color .3s}
.field select:focus,.field input:focus{outline:none;border-color:var(--q)}
.field .chk{display:flex;align-items:center;gap:8px;font-size:.8rem;color:var(--fg)}
.prow{display:flex;align-items:center;gap:10px;margin-top:16px;flex-wrap:wrap}
.prow button{padding:.46rem 1rem;border-radius:10px;border:1px solid var(--line);cursor:pointer;
  font:inherit;font-size:.78rem;font-weight:600;transition:all .25s;background:transparent;color:var(--fg)}
.prow .primary{background:linear-gradient(135deg,var(--q),var(--fg));border:none;color:#05121f}
html[data-theme=light] .prow .primary{color:#fff}
.prow .ghost{color:var(--muted)}
.prow .hint{font-size:.68rem;color:var(--dim)}
#cfg-list .crow{display:grid;grid-template-columns:1.1fr 1fr;gap:6px 14px;padding:9px 0;
  border-bottom:1px solid rgba(148,163,184,.09);align-items:center}
#cfg-list .ck{font-size:.78rem;font-weight:600}
#cfg-list .ch{grid-column:1/3;font-size:.68rem;color:var(--muted);line-height:1.5}
@media (max-width:700px){#cfg-list .crow{grid-template-columns:1fr}#cfg-list .ch{grid-column:auto}}

/* ---------------- about ---------------- */
details.drawer{border:1px solid var(--line);border-radius:18px;background:var(--card);
  backdrop-filter:blur(12px);overflow:hidden;transition:border-color .35s;margin-bottom:14px}
details.drawer[open]{border-color:color-mix(in srgb,var(--q) 30%,var(--line))}
details.drawer>summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:10px;
  padding:15px 20px;font-size:.84rem;font-weight:600;color:var(--fg);transition:color .3s}
details.drawer>summary::-webkit-details-marker{display:none}
details.drawer>summary:hover{color:var(--q)}
details.drawer>summary .arr{margin-left:auto;color:var(--muted);transition:transform .4s}
details.drawer[open]>summary .arr{transform:rotate(180deg)}
details.drawer .dbody{padding:2px 20px 20px;animation:rise .45s both}
details.drawer .dbody p{margin:.3em 0;font-size:.78rem;color:var(--muted);line-height:1.8}
details.drawer>summary .tag{font-size:.6rem;letter-spacing:.18em;color:var(--dim)}
details.drawer .pnote{margin:0 0 14px}
details.drawer .dbody .ptitle{display:none}
.inf-grid{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));align-items:start}
.inf-card.wide{grid-column:1/-1}
.mechwrap{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:20px;align-items:center}
@media (max-width:880px){.mechwrap{grid-template-columns:1fr}}
.inf-card{position:relative;border:1px solid var(--line);border-radius:18px;background:var(--card);
  backdrop-filter:blur(12px);padding:16px 18px;transition:border-color .35s,transform .35s;box-shadow:var(--shadow)}
.inf-card:hover{transform:translateY(-3px);border-color:color-mix(in srgb,var(--q) 35%,var(--line))}
.inf-card.c2:hover{border-color:color-mix(in srgb,var(--s) 35%,var(--line))}
.inf-card.c3:hover{border-color:color-mix(in srgb,var(--read) 40%,var(--line))}
.inf-card h3{margin:0 0 12px;font-size:.84rem;letter-spacing:.06em;display:flex;align-items:center;gap:9px}
.inf-card h3::before{content:"";width:8px;height:8px;border-radius:3px;background:var(--q);box-shadow:0 0 10px var(--q)}
.inf-card.c2 h3::before{background:var(--s);box-shadow:0 0 10px var(--s)}
.inf-card.c3 h3::before{background:var(--read);box-shadow:0 0 10px var(--read)}
.inf-card details.drawer{border:1px dashed var(--line);background:transparent;margin:14px 0 0}
.inf-card details.drawer>summary{padding:10px 14px;font-size:.76rem}
.mech{margin:12px 0 0;padding:0 0 0 1.3em;list-style:decimal;font-size:.78rem;line-height:1.7}
.mech li{margin:.35em 0;color:var(--fg)}
.mech b{color:var(--q)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;font-size:.78rem;margin:0}
.kvbar{margin-top:16px;padding-top:13px;border-top:1px solid var(--line)}
.kvbar h4{margin:0 0 9px;font-size:.68rem;letter-spacing:.2em;color:var(--muted);font-weight:600}
.kvpills{display:grid;grid-template-columns:repeat(auto-fit,minmax(235px,1fr));gap:8px}
.kvchip{font-size:.72rem;color:var(--muted);border:1px solid var(--line);border-radius:9px;padding:.3rem .7rem;
  background:rgba(148,163,184,.05);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.kvchip b{color:var(--fg);font-weight:600;margin-left:6px;font-variant-numeric:tabular-nums}
.kv dt{color:var(--muted);white-space:nowrap}
.kv dd{margin:0;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.qrow{display:flex;flex-direction:column;gap:3px;padding:9px 0;border-bottom:1px solid rgba(148,163,184,.09)}
.qrow:last-of-type{border-bottom:none}
.qrow b{font-size:.78rem}
.qrow span{font-size:.74rem;color:var(--muted);line-height:1.65}
.diagram{width:100%;height:auto;margin:2px 0 4px}
.diagram .box{fill:rgba(148,163,184,.07);stroke:var(--line)}
.diagram .gw{fill:color-mix(in srgb,var(--q) 10%,transparent);stroke:var(--q)}
.diagram .cf{fill:color-mix(in srgb,var(--ok) 8%,transparent);stroke:var(--ok)}
.diagram text{fill:var(--fg);font-size:12px;font-family:inherit}
.diagram .sm{fill:var(--muted);font-size:11px}
.diagram .ln{stroke:var(--muted);stroke-width:1.2;fill:none}
.diagram .dsh{stroke:var(--s);stroke-dasharray:5 4;fill:none;stroke-width:1.2}
.diagram .dsh2{stroke:var(--ok);stroke-dasharray:5 4;fill:none;stroke-width:1.2}
/* ---------------- dyn ---------------- */
#events{display:grid;gap:9px;margin-bottom:18px}
.ev{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:12px;
  background:var(--card);padding:.5rem .85rem;font-size:.78rem;animation:rise .4s both}
.ev .kind{flex:none;font-weight:700;font-size:.66rem;letter-spacing:.08em;padding:.14rem .55rem;border-radius:7px}
.ev.load .kind{color:var(--ok);border:1px solid var(--ok)}
.ev.unload .kind{color:var(--s);border:1px solid var(--s)}
.ev.comfy .kind{color:var(--q);border:1px solid var(--q)}
.ev.switch .kind,.ev.backend .kind{color:var(--read);border:1px solid var(--read)}
.ev.error .kind{color:var(--err);border:1px solid var(--err)}
.ev time{color:var(--dim);font-size:.68rem;font-variant-numeric:tabular-nums;flex:none}
.ev p{margin:0;color:var(--fg);overflow-wrap:anywhere}
#events.open{max-height:452px;overflow-y:auto}
.evbtn{background:transparent;border:1px solid var(--line);color:var(--muted);border-radius:10px;
  padding:.42rem .95rem;font:inherit;font-size:.74rem;cursor:pointer;transition:all .25s;justify-self:start}
.evbtn:hover{color:var(--q);border-color:var(--q)}
footer{margin-top:40px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;color:var(--muted);
  font-size:.78rem;animation:rise .6s .66s both}
footer input{padding:.42rem .6rem;border-radius:9px;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:.78rem}
footer button{padding:.42rem .9rem;border-radius:9px;border:1px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer}
footer a{color:var(--q)}
.flash{animation:flash 1.8s ease}
@keyframes flash{0%,55%{box-shadow:0 0 40px -6px var(--q)}100%{box-shadow:none}}
@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important}
  #fx{display:none}
}
</style>
</head>
<body>
<canvas id="fx"></canvas>
<div class="blobs" aria-hidden="true"><i></i><i></i></div>
<div id="bgstage" aria-hidden="true"><video id="bgvid" loop playsinline preload="auto" muted src="router/assets/bg-loop.mp4"></video><div id="bgmask"></div></div>
<div class="wrap">
<header>
  <div class="logo"><svg viewBox="0 0 24 24"><path d="M4 17.5 12 3l8 14.5-8 4.5-8-4.5Zm8-11-5.4 9.8L12 18.7l5.4-4.4L12 6.5Z"/></svg></div>
  <h1>STRATA<small>模型加载台 · LOAD CONSOLE</small></h1>
  <div class="spacer"></div>
  <div id="comfy"><span>ComfyUI</span><span class="bar"><i></i></span><b>检测中…</b><button class="cbtn" id="cfree" title="发 /free 并确证显存读数下降；不打断正在跑的任务">清理显存</button><button class="cbtn danger" id="cforce" title="先打断任务、清空队列，再释放显存并等到让卡">强制清理</button></div>
  <button id="theme" title="切换深色/亮色主题" aria-label="切换主题">
    <svg class="sun" viewBox="0 0 24 24"><path d="M12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm0-5a1 1 0 0 1 1 1v1.5a1 1 0 0 1-2 0V2.5a1 1 0 0 1 1-1Zm0 17a1 1 0 0 1 1 1v1.5a1 1 0 0 1-2 0V20.5a1 1 0 0 1 1-1ZM2.5 11h1.5a1 1 0 0 1 0 2H2.5a1 1 0 0 1 0-2Zm17 0h1.5a1 1 0 0 1 0 2H19.5a1 1 0 0 1 0-2ZM5.1 5.1l1.1 1.1a1 1 0 0 1-1.4 1.4L3.7 6.5a1 1 0 0 1 1.4-1.4Zm12.7 12.7 1.1 1.1a1 1 0 0 1-1.4 1.4l-1.1-1.1a1 1 0 0 1 1.4-1.4Zm1.4-12.7a1 1 0 0 1 0 1.4l-1.1 1.1a1 1 0 0 1-1.4-1.4l1.1-1.1a1 1 0 0 1 1.4 0ZM6.2 16.8a1 1 0 0 1 0 1.4l-1.1 1.1a1 1 0 0 1-1.4-1.4l1.1-1.1a1 1 0 0 1 1.4 0Z"/></svg>
    <svg class="moon" viewBox="0 0 24 24"><path d="M20.4 14.2A8.6 8.6 0 0 1 9.8 3.6a8.6 8.6 0 1 0 10.6 10.6Z"/></svg>
  </button>
</header>

<div class="hero">
  <p>一块 <b>RTX 3090</b> · 两档 <b>Qwen3.8-Flash-Next IQ3_S</b> · 一个把换装、显存腾让、监控和调教都收进一页的本地推理网关 —— 这就是 Strata。</p>
  <div class="chips"><span>GSQ-RCO IQ3_S 量化</span><span>512K 上下文 · YaRN</span><span>MoE 专家动态路由</span><span>n-gram 投机解码</span><span>Vision 图像输入</span><span>与 ComfyUI 互相让卡</span></div>
</div>
<p class="lead">两档模型<b>互斥驻留</b>（64GB 内存只装得下其一）——点 Load，网关先让在位模型退场、让 ComfyUI 放卡，再加载你点的这一档（冷加载约 1.5-3 分钟，卡片会转圈报用时）。加载成功后本页下方就是 <b>monitor</b>，不用再跳任何页面；<a href="/">web UI</a> 依然保留给聊天。任何模型都不在驻时，本页就是唯一入口。</p>

<div class="vidbar">
  <span class="vlab">本页视频</span>
  <div class="seg" id="seg-bg">
    <button data-bg="off">关闭</button><button data-bg="bg">背景播放</button><button data-bg="solo">单独播放</button>
  </div>
  <button class="cbtn" id="vid-sound" title="开=视频带原声（浏览器要求先点过页面才会出声）；关=静音">声音: 关</button>
  <span class="vhint">素材 = gw-assets 里的 bg-loop.mp4，循环播放；换文件后刷新即见</span>
</div>

<div id="cards"></div>
<p id="msg"></p>

<h2 class="sec" id="sec-monitor">Monitor<em>引擎实况 · 与原版同字段</em></h2>
<div class="monstate" id="mon-bar" style="--ac:var(--q)">
  <span id="mon-chip">—</span><span id="mon-who"></span><span id="mon-detail"></span>
  <span id="mon-prog"><i></i></span>
</div>
<div id="mon"></div>
<p id="mon-strip"></p>
<div class="reqwrap">
  <table id="mon-table"><thead><tr>
  <th>时刻</th><th>状态</th><th>提示词</th><th>KV 复用</th><th>生成</th><th>预填 t/s</th><th>解码 t/s</th><th>显存命中率</th><th>时长</th>
  </tr></thead><tbody id="mon-tb"></tbody></table>
</div>
<p id="mon-hint"></p>

<h2 class="sec" id="sec-settings">调教台<em>Settings</em></h2>
<div class="seg" id="seg-models"></div>
<details class="drawer" id="drawer-sampling">
<summary>采样默认值<span class="tag">LIVE · 即时生效</span><span class="arr">▾</span></summary>
<div class="dbody">
  <p class="pnote">后端 /settings：没自带参数的客户端（Hermes、酒馆、脚本）都吃这份默认。留空 = 交回模型卡自己的默认。</p>
  <div class="fgrid">
    <div class="field"><label for="stemp">temperature<output id="ostemp"></output></label><input type="range" id="stemp" min="0" max="2" step="0.05"></div>
    <div class="field"><label for="stop_p">top_p<output id="os-top_p"></output></label><input type="range" id="stop_p" min="0" max="1" step="0.01" value="0.95"></div>
    <div class="field"><label for="stop_k">top_k<output id="os-top_k"></output></label><input type="range" id="stop_k" min="1" max="64" step="1" value="20"></div>
    <div class="field"><label for="seffort">思考等级</label><select id="seffort"><option value="">模型默认</option><option value="none">none</option><option value="low">low</option><option value="medium">medium</option><option value="high">high</option></select></div>
    <div class="field"><label for="sbudget">思考预算 tokens</label><input type="text" id="sbudget" inputmode="numeric" placeholder="不限"></div>
    <div class="field"><label for="sseed">seed</label><input type="text" id="sseed" inputmode="numeric" placeholder="随机"></div>
    <div class="field"><label for="smax">max tokens</label><input type="text" id="smax" inputmode="numeric" placeholder="默认"></div>
    <div class="field"><label>加速预测</label><span class="chk"><input type="checkbox" id="sesp"><span>experimental speed projection</span></span></div>
  </div>
  <div class="prow"><button class="primary" id="s-save">保存采样默认</button><button class="ghost" id="s-clear">清除（各端自带参数）</button><span class="hint">GET/POST /settings</span></div>
</div></details>
<details class="drawer" id="drawer-config">
<summary>Model settings<span class="tag">NEXT START · 下次启动生效</span><span class="arr">▾</span></summary>
<div class="dbody">
  <p class="pnote" id="cfg-note">后端 /config 白名单键。保存时 Strata 官方会自动备份配置 json；改动从该模型下次启动起生效。留空 = 删除该键（回默认）。</p>
  <div id="cfg-list"></div>
  <div class="prow"><button class="primary" id="c-save">保存 Model settings</button><span class="hint">保存后需重启该模型才见效</span></div>
</div></details>

<h2 class="sec" id="sec-about">关于 Strata<em>About</em></h2>
<div class="inf-grid">
  <div class="inf-card wide">
    <h3>Strata 引擎与本机架构</h3>
    <div class="mechwrap">
    <svg class="diagram" viewBox="0 0 640 246" role="img" aria-label="Strata 本机架构示意图">
      <rect class="box gw" x="210" y="8" width="220" height="46" rx="11"/>
      <text x="320" y="28" text-anchor="middle">strata-gw 网关 :18080</text>
      <text class="sm" x="320" y="44" text-anchor="middle">本页 · 统一入口</text>
      <rect class="box" x="58" y="92" width="200" height="46" rx="11"/>
      <text x="158" y="112" text-anchor="middle">qwen 后端 :18081</text>
      <text class="sm" x="158" y="128" text-anchor="middle">lazy · 官方 IQ3_S 档</text>
      <rect class="box" x="382" y="92" width="200" height="46" rx="11"/>
      <text x="482" y="112" text-anchor="middle">sc117 后端 :18082</text>
      <text class="sm" x="482" y="128" text-anchor="middle">lazy · abliterated 档</text>
      <rect class="box" x="30" y="178" width="200" height="46" rx="11"/>
      <text x="130" y="198" text-anchor="middle">strata 引擎进程</text>
      <text class="sm" x="130" y="214" text-anchor="middle">按需拉起 · 请求驱动</text>
      <rect class="box" x="245" y="178" width="150" height="46" rx="11"/>
      <text id="dg-ram" x="320" y="198" text-anchor="middle">DDR4 · 64 GB</text>
      <text class="sm" x="320" y="214" text-anchor="middle">专家权重常驻</text>
      <rect class="box" x="412" y="178" width="198" height="46" rx="11"/>
      <text id="dg-gpu" x="511" y="198" text-anchor="middle">RTX 3090 · 24 GB</text>
      <text class="sm" x="511" y="214" text-anchor="middle">热缓存换入 · 只坐一位</text>
      <defs>
        <marker id="arM" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto"><path d="M0 .5l7 3.5-7 3.5z" fill="var(--muted)"/></marker>
        <marker id="arS" viewBox="0 0 8 8" refX="6.5" refY="4" markerWidth="6.5" markerHeight="6.5" orient="auto"><path d="M0 .5l7 3.5-7 3.5z" fill="var(--s)"/></marker>
      </defs>
      <path class="ln" d="M266 54L158 88" marker-end="url(#arM)"/>
      <path class="ln" d="M374 54L482 88" marker-end="url(#arM)"/>
      <path class="ln" d="M158 138L144 174" marker-end="url(#arM)"/>
      <path class="ln" d="M474 138L352 174" marker-end="url(#arM)"/>
      <path class="ln" d="M232 201H241" marker-end="url(#arM)"/>
      <path class="dsh" d="M395 201H406" marker-end="url(#arS)"/>
      <text class="sm" x="403" y="238" text-anchor="middle">按热度换入</text>
    </svg>
    <ol class="mech">
      <li><b>懒加载</b>：点 Load 才拉起对应后端与引擎进程；模型不在位时零占用，任何请求到来也会按需自动装载。</li>
      <li><b>互斥驻留</b>：两档 55 GB 模型在 64 GB 内存里只装得下其一——换档时网关先让在位模型退场、确证显存已释放，再冷加载新档（约 1.5-3 分钟，卡片转圈报用时）。</li>
      <li><b>闲置回收</b>：30 分钟没有请求自动卸载腾卡，之后热重载秒级；「不是网关出手」的卸载（闲置计时等）也会被看门狗记进下方动态时间线。</li>
      <li><b>引擎结构</b>：MoE 专家常驻内存、显存只留按热度换入换出的热缓存；KV 量化（K8V4）+ YaRN 扩到 512K；n-gram 草稿 + MTP 投机解码；vision 塔另占小槽。</li>
    </ol>
    </div>
    <div class="kvbar"><h4>运行档案</h4><div class="kvpills" id="eng-kv"><span class="kvchip"><b>加载中…</b></span></div></div>
  </div>
</div>

<h2 class="sec" id="sec-dyn">动态<em>Events</em></h2>
<div id="events"></div>

<footer>
  <span>API key（与 web UI About&gt;Settings 同一把）:</span>
  <input id="key" type="password" size="22" autocomplete="off">
  <button id="save">保存</button>
  <span class="spacer"></span>
  <a href="/">web UI</a> · <span>状态每 2 秒自动刷新</span>
</footer>
</div>
<script>
(function(){
"use strict";
var root=document.documentElement;
var saved=null;try{saved=localStorage.getItem("stratagw.theme")}catch(e){}
var theme=saved||(window.matchMedia&&matchMedia("(prefers-color-scheme: light)").matches?"light":"dark");
function applyTheme(t){root.dataset.theme=t;try{localStorage.setItem("stratagw.theme",t)}catch(e){}}
applyTheme(theme);
document.getElementById("theme").onclick=function(){applyTheme(root.dataset.theme==="dark"?"light":"dark")};

var META={
  "qwen3.8-flash-next-iq3_s":{ac:"q",nick:"qwen 酱",who:"银灰长直 · 清冷图书管理员",
    sub:"ISTA 官方原版权重 · Qwen-Sharp 模板",tags:["官方原版","完整思考链","工具调用忠实","agent 主力"],
    specs:[["量化档","IQ3_S · GSQ-RCO"],["权重","54.8 GB GGUF"],["专家","46.85G 内存 + 14.4G 显存"],["上下文","512 K · YaRN×2 · K8V4"],["投机解码","MTP + n-gram 共享分片"],["图像输入","strata-vision"]],
    style:"官方复刻档：思考链完整、工具调用忠实——agent、编码与长文主力。",
    notes:["与 sc117 互斥，内存只驻得下其一","冷加载 1.5-3 分钟 · 热重载秒级","思考默认 medium，全关会掉质量"],
    art:"router/assets/qwen-chan.png"},
  "sc117-qwen3.8-flash-next-abliterated-iq3_s":{ac:"s",nick:"sc117 酱",who:"粉挑染 · 元气小恶魔",
    sub:"SC117 · abliterated 去拒绝版",tags:["去拒绝","角色扮演","小说写作","酒馆 RP"],
    specs:[["量化档","IQ3_S · SC117 消融"],["权重","55.1 GB GGUF"],["专家","46.85G 内存 + 14.4G 显存"],["上下文","512 K · YaRN×2 · K8V4"],["投机解码","MTP + n-gram（同分片）"],["图像输入","mmproj-Swift"]],
    style:"去拒绝变体：敏感剧情、角色扮演不说教不拒答——酒馆 RP 与创作首选。",
    notes:["与官方档互斥，换档 = 卸载 + 冷加载","独立学一份路由画像，越用越热","两档质量同级，只差安全微调"],
    art:"router/assets/sc117-chan.png"}
};
function metaFor(n){
  var m=META[n];
  if(m)return m;
  return {ac:"q",nick:n,who:"网关新发现的模型",sub:"自动挂载",tags:["自动挂载"],
    specs:[["配置文件","strata-…json"]],
    style:"网关扫描到了一份新的 strata-*.json。在网关文件 GATEWAY_HTML 的 META 里为它补一份介绍和立绘路径，这张卡片就会变成和另外两张一样的详细档案。",
    notes:["与其它模型互斥加载"],art:""};
}

var keyEl=document.getElementById("key"),msg=document.getElementById("msg");
try{keyEl.value=localStorage.getItem("stratagw.key")||""}catch(e){}
document.getElementById("save").onclick=function(){
  try{localStorage.setItem("stratagw.key",keyEl.value.trim())}catch(e){}
  say("key 已保存在本浏览器。","");
};
function say(t,cls){msg.textContent=t;msg.className=cls||""}
function hdrs(needJson){var h={};var k=keyEl.value.trim();if(k)h.Authorization="Bearer "+k;
  if(needJson)h["Content-Type"]="application/json";return h}
function esc(s){var d=document.createElement("div");d.textContent=s;return d.innerHTML}
function tstr(t){var d=new Date(t*1000);return ("0"+d.getHours()).slice(-2)+":"+("0"+d.getMinutes()).slice(-2)+":"+("0"+d.getSeconds()).slice(-2)}
function num(v){if(v==null)return "–";var s=""+Math.round(v);
  return s.replace(/([0-9])(?=([0-9]{3})+$)/g,"$1,")}
function fnum(v,d2){if(v==null||isNaN(v))return "–";var f=Math.pow(10,d2||0);return Math.round(v*f)/f}
function qs(url,cb){fetch(url,{headers:hdrs(false)}).then(function(r){return r.ok?r.json():Promise.reject(r.status)}).then(cb).catch(function(){})}
function postj(url,obj,cb){fetch(url,{method:"POST",headers:hdrs(true),body:JSON.stringify(obj)})
  .then(function(r){return r.json().then(function(j){return[r.status,j]}).catch(function(){return[r.status,{}]})}).then(cb)
  .catch(function(e){say("请求失败: "+e,"err")})}

var ops={};      // 本页乐观进行态（服务端 busy 一到就以服务端为准）
var prev={};    // 上次轮询的 loaded 状态（发现加载完成）
var sig="";
var cardsEl=document.getElementById("cards");
var modelsList=[];
var selName=null;
var mon={data:null};

function cardHTML(name,meta){
  var artHtml='<div class="art"><img alt="'+esc(meta.nick)+'立绘" src="'+meta.art+'" '+
    'onerror="this.remove()" onload="this.classList.add(&quot;landed&quot;);var p=this.parentNode&&this.parentNode.querySelector(&quot;.art-ph&quot;);if(p)p.remove()">'+
    '<div class="art-ph"><span class="nick">'+esc(meta.nick)+'</span><i></i>'+
    '<span class="who">'+esc(meta.who)+'</span><span class="pend">立绘待入</span></div></div>';
  return artHtml+'<div class="cbody">'+
    '<div class="mhead"><div><h3 title="'+esc(name)+'">'+esc(name)+'</h3><div class="sub">'+esc(meta.sub)+'</div></div></div>'+
    (meta.specs.length?'<h4 class="mod">技术档案</h4><dl class="specs">'+meta.specs.map(function(p){
      return '<div class="srow"><dt>'+esc(p[0])+'</dt><dd>'+esc(p[1])+'</dd></div>'}).join("")+'</dl>':"")+
    '<h4 class="mod">风格与适用场景</h4><div class="tags">'+meta.tags.map(function(t){return '<span>'+esc(t)+'</span>'}).join("")+'</div>'+
    '<p class="prose">'+esc(meta.style)+'</p>'+
    '<h4 class="mod">使用提醒</h4><ul class="notes">'+meta.notes.map(function(n){return '<li>'+esc(n)+'</li>'}).join("")+'</ul>'+
    '<div class="acts"><button class="load" data-r="toggle">载入</button>'+
    '<span class="statechip" data-r="live">待加载</span>'+
    '<span class="ring" data-r="ring"><svg viewBox="0 0 36 36"><circle class="trk" cx="18" cy="18" r="14.5"/>'+
    '<circle class="arc" cx="18" cy="18" r="14.5"/></svg><span data-r="elapsed">0s</span></span></div>';
}
function build(names){
  cardsEl.innerHTML="";
  names.forEach(function(n){
    var meta=metaFor(n);
    var card=document.createElement("div");
    card.className="card";card.dataset.accent=meta.ac;card.dataset.model=n;
    card.innerHTML=cardHTML(n,meta);
    card.querySelector('[data-r=toggle]').onclick=function(){
      act(card.dataset.st==="loaded"?"unload":"load",n);
    };
    cardsEl.appendChild(card);
  });
}
function paint(list){
  var busyNow=false;
  list.forEach(function(b){
    if(b.busy)delete ops[b.model];
    else if(b.loaded&&ops[b.model]&&ops[b.model].op==="load")delete ops[b.model];
    else if(b.alive&&!b.loaded&&ops[b.model]&&ops[b.model].op==="unload")delete ops[b.model];
    if(b.busy||ops[b.model])busyNow=true;
  });
  list.forEach(function(b){
    var card=cardsEl.querySelector('[data-model="'+b.model+'"]');
    if(!card)return;
    var st=!b.alive?"down":(b.loaded?"loaded":"unloaded");
    var act2=b.busy?{op:b.busy.op,t0:Date.now()-b.busy.elapsed_s*1000}:ops[b.model];
    card.dataset.st=st;
    var tg=card.querySelector('[data-r=toggle]'),
        ring=card.querySelector('[data-r=ring]'),el=card.querySelector('[data-r=elapsed]'),
        live=card.querySelector('[data-r=live]');
    var willUnload=(st==="loaded");
    tg.textContent=act2?(act2.op==="load"?"载入中…":"卸载中…"):(willUnload?"卸载":"载入");
    tg.className=act2?(act2.op==="load"?"load":"warnbtn"):(willUnload?"warnbtn":"load");
    tg.disabled=(st==="down"||busyNow);
    if(act2){ring.classList.add("on");
      var e0=Math.round((Date.now()-act2.t0)/1000);
      el.textContent=e0<100?(e0+"s"):(Math.floor(e0/60)+"m"+("0"+(e0%60)).slice(-2)+"s");}
    else ring.classList.remove("on");
    var lv=mon.data&&mon.data.live?mon.data.live:null;
    if(st==="down")live.textContent="离线";
    else if(act2)live.textContent=(act2.op==="load"?"请上卡":"让卡中");
    else if(st==="loaded")live.textContent=(lv&&lv.state==="generating")?(fnum(lv.tok_s,1)+" tok/s"):
      ((lv&&lv.state==="reading")?"读提示词":"静驻");
    else live.textContent="待加载";
  });
}
function refresh(){
  fetch("router/backends").then(function(r){return r.json()}).then(function(d){
    var list=d.backends||[];modelsList=list;
    var names=list.map(function(b){return b.model});
    if(names.join("|")!==sig){sig=names.join("|");build(names);buildSeg()}
    list.forEach(function(b){
      var was=prev[b.model];
      if(was===false&&b.loaded===true){
        say(b.model+" 已载入 —— monitor 已就绪，页面见下方。","busy");
        var sec=document.getElementById("sec-monitor");
        sec.classList.remove("flash");void sec.offsetWidth;sec.classList.add("flash");
        sec.scrollIntoView({behavior:"smooth",block:"start"});
      }else if(was===true&&b.loaded===false&&!b.busy){
        say(b.model+" 已卸载，显存已让出。","");
      }
      prev[b.model]=b.loaded;
    });
    var anyLoaded=list.some(function(b){return b.loaded});
    var loadedNow=list.filter(function(b){return b.loaded});
    if(!selName||!list.some(function(b){return b.model===selName})){
      if(loadedNow[0]||list[0])selectModel((loadedNow[0]||list[0]).model,true);
    }else if(selName&&loadedNow.length&&loadedNow.every(function(b){return b.model!==selName})){
      selectModel(loadedNow[0].model,true);
    }
    paint(list);
  }).catch(function(e){say("读后端列表失败: "+e,"err")});
  fetchComfy();
}
function act(op,name){
  if(ops[name])return;
  ops[name]={op:op,t0:Date.now()};
  refresh();
  fetch(op,{method:"POST",headers:hdrs(true),body:JSON.stringify({model:name})})
    .then(function(r){return r.json().then(function(j){return[r.status,j]}).catch(function(){return[r.status,{}]})})
    .then(function(rj){
      if(rj[0]>=400){delete ops[name];
        say(op+" "+name+" 失败 HTTP "+rj[0]+" "+((rj[1].error&&rj[1].error.message)||""),"err");
        refresh()}
    })
    .catch(function(e){delete ops[name];say(op+" "+name+" 失败: "+e,"err");refresh()});
}

/* ---------------- monitor ---------------- */
var TILES=[
  {key:"decode",label:"解码速度",unit:"tok/s",series:"tok_s",dec:1},
  {key:"prefill",label:"预填速度",unit:"tok/s",series:"prefill_tok_s_mean"},
  {key:"gpu",label:"GPU 负载",unit:"%",series:"gpu_util"},
  {key:"vram",label:"显存占用",unit:"GB",series:"gpu_mem_used"},
  {key:"temp",label:"GPU 温度",unit:"°C",series:"gpu_temp"},
  {key:"power",label:"GPU 功耗",unit:"W",series:"gpu_power"},
  {key:"pcie",label:"PCIe→显存",unit:"MB/s",series:"gpu_pcie_rx_mb"},
  {key:"cpu",label:"CPU",unit:"%",series:"cpu",alt:true},
  {key:"disk",label:"磁盘读取",unit:"MB/s",series:"disk_read_mb"}
];
function gbf(v,d){if(v==null||isNaN(v))return "–";var x=v/1073741824;return d?x.toFixed(d):""+(Math.round(x*10)/10)}
function kfmt(v){if(v==null)return "–";if(v>=1000000)return (v/1000000).toFixed(2)+"M";if(v>=1000)return (v/1000).toFixed(1)+"K";return ""+v}
function flatSpark(){return '<svg viewBox="0 0 100 32" preserveAspectRatio="none"><path class="line" d="M0,30L100,30" style="stroke-dasharray:3 3;opacity:.55"/></svg>'}
function spark(arr,max){
  if(!arr||arr.length<2)return flatSpark();
  var mx=0,i;for(i=0;i<arr.length;i++){if(arr[i]>mx)mx=arr[i]}
  if(max)mx=Math.max(mx,max);if(!(mx>0))mx=1;
  var n=arr.length,pts=[];
  for(i=0;i<n;i++){pts.push((i*100/(n-1)).toFixed(1)+","+(30-(arr[i]/mx)*26).toFixed(1))}
  var line="M"+pts.join("L");
  return '<svg viewBox="0 0 100 32" preserveAspectRatio="none"><path class="area" d="M0,32L'+pts.join("L")+'L100,32Z"/><path class="line" d="'+line+'"/></svg>';
}
function phTiles(){
  document.getElementById("mon").innerHTML=
    TILES.map(function(m){
      return '<div class="tile ph'+(m.alt?" alt":"")+'"><div class="lab">'+m.label+'</div>'+
        '<div class="val">–<small>'+m.unit+'</small></div><div class="sub">载入后点亮</div>'+flatSpark()+'</div>';
    }).join("")+
    '<div class="tile ph"><div class="lab">上下文填充</div><div class="val">–<small>%</small></div><div class="sub">最近请求占窗口比</div><div class="pbar"><i style="width:0"></i></div></div>'+
    '<div class="tile ph"><div class="lab">显存专家缓存</div><div class="val">–<small>槽</small></div><div class="sub">热专家占显存比</div><div class="pbar"><i style="width:0"></i></div></div>'+
    '<div class="tile ph"><div class="lab">系统内存</div><div class="val">–<small>GB</small></div><div class="sub">引擎常驻水位</div><div class="pbar ram"><i style="width:0"></i></div></div>';
}
var FIN={stop:["ok","已完成"],length:["len","触上限"],cancel:["stop","已停止"],disconnect:["stop","已断开"],error:["err","错误"],timeout:["stop","超时"]};
var TROWS=10;
function phRow(){return '<tr class="phr"><td>–</td><td><span class="fin">–</span></td><td>–</td><td>–</td><td>–</td><td>–</td><td>–</td><td>–</td><td>–</td></tr>'}
function renderMonitor(){
  var bar=document.getElementById("mon-bar");
  var chip=document.getElementById("mon-chip");
  var det=document.getElementById("mon-detail");
  var who=document.getElementById("mon-who");
  var prog=document.querySelector("#mon-prog i");
  var strip=document.getElementById("mon-strip");
  var tb=document.getElementById("mon-tb");
  var hint=document.getElementById("mon-hint");
  var meta=metaFor(selName||"");
  bar.style.setProperty("--ac","var(--"+(meta.ac==="s"?"s":"q")+")");
  chip.className="";det.textContent="";who.textContent=selName?"· "+selName:"";prog.style.width="0";
  var d=mon.data;
  if(!d){
    chip.textContent="待载入";
    det.textContent="拿不到 /metrics——多半是页脚 api key 没填，或该后端进程未起";
    phTiles();strip.textContent="";
    tb.innerHTML=phRow().repeat(TROWS);
    hint.textContent="尚无请求记录——统计从引擎启动起累计";
    return;
  }
  var eng=d.engine||{},lv=d.live||{},hw=d.hardware||{},st=d.hardware_static||{},
      h=d.history||{},t=d.totals||{};
  var requests=d.requests||[],last=requests[0]||null;
  var loaded=modelsList.some(function(b){return b.model===selName&&b.loaded});
  var state=lv.state||"unloaded";
  if(loaded&&lv.queued>0&&state!=="generating"&&state!=="reading")state="queued";
  var STATE={idle:"待机",reading:"读提示词",generating:"生成中",queued:"排队中",unloaded:"已卸载",error:"异常"};
  if(!loaded)state="unloaded";
  chip.textContent=STATE[state]||state;
  if(state==="generating"){
    chip.className="gen";
    det.textContent=num(lv.generated)+" tok · "+fnum(lv.tok_s,1)+" tok/s"+(lv.phase?" · "+lv.phase:"");
    if(lv.max_tokens)prog.style.width=Math.min(100,(100*(lv.generated||0))/lv.max_tokens)+"%";
  }else if(state==="reading"){
    chip.className="reading";
    if(lv.prompt_total){det.textContent=num(lv.prompt_read)+" / "+num(lv.prompt_total)+" tok · "+Math.round(100*(lv.prompt_read||0)/lv.prompt_total)+"%";
      prog.style.width=Math.min(100,100*(lv.prompt_read||0)/lv.prompt_total)+"%";}
    else det.textContent=num(lv.prompt_tokens)+" tok";
  }else if(state==="queued"){
    chip.className="reading";
    det.textContent=(lv.queued||0)+" 个请求排队 · 先让上一个说完";
  }else if(state==="idle"){
    chip.className="idle";
    det.textContent=last?("上次: "+num(last.output_tokens)+" tok · "+fnum(last.decode_tok_s,1)+" tok/s"):"等待请求";
  }else{
    det.textContent="引擎未驻留——下方硬件读数仍是实时的（画布出图也在同一块卡上）";
  }
  var decodeAvg=(t.decode_ms&&t.output_tokens)?t.output_tokens/(t.decode_ms/1000):null;
  var readTok=(t.prompt_tokens||0)-(t.reused||0);
  var avgPrefill=(t.prompt_ms>0&&readTok>0)?readTok/(t.prompt_ms/1000):null;
  var decodeV=(state==="generating")?lv.tok_s:(decodeAvg!=null?decodeAvg:(last?last.decode_tok_s:null));
  var prefillV=(lv.state&&lv.state!=="idle"&&lv.prefill_tok_s_mean!=null)?lv.prefill_tok_s_mean
              :(avgPrefill!=null?avgPrefill
              :(last&&last.prompt_ms>0?Math.max(0,(last.prompt_tokens||0)-(last.reused||0))/(last.prompt_ms/1000):null));
  var speedSub=state==="generating"?"当前 decode":(decodeAvg!=null?"decode · 运行均值":(last?"上次请求":"等待首次"));
  var preSub=state==="reading"?"当前 prefill":(avgPrefill!=null?"prefill · 运行均值":(last?"上次请求":"等待首次"));
  function std(m,val,unit,sub,amax){
    return '<div class="tile'+(m.alt?" alt":"")+'"><div class="lab">'+m.label+'</div>'+
      '<div class="val">'+val+(unit?'<small>'+unit+'</small>':"")+'</div>'+
      '<div class="sub">'+(sub||"")+'</div>'+spark(h[m.series],amax)+'</div>';
  }
  var tiles=[],amax,sub2;
  TILES.forEach(function(m){
    var val;
    if(m.key==="decode"){val=fnum(decodeV,1);sub2=speedSub;amax=null}
    else if(m.key==="prefill"){val=fnum(prefillV,0);sub2=preSub;amax=null}
    else if(m.key==="gpu"){val=fnum(hw.gpu_util,0);sub2=st.gpu_name?esc(st.gpu_name):"利用率";amax=100}
    else if(m.key==="vram"){val=gbf(hw.gpu_mem_used,1);
      sub2=eng.expert_slots?(num(eng.expert_slots)+" experts cached"):(hw.gpu_mem_total?("共 "+gbf(hw.gpu_mem_total,0)+" GB"):"");amax=hw.gpu_mem_total}
    else if(m.key==="temp"){val=fnum(hw.gpu_temp,0);sub2="阈值 90°C";amax=90}
    else if(m.key==="power"){val=fnum(hw.gpu_power,0);sub2=hw.gpu_power_limit?("上限 "+fnum(hw.gpu_power_limit,0)+" W"):"";amax=hw.gpu_power_limit}
    else if(m.key==="pcie"){val=fnum(hw.gpu_pcie_rx_mb,(hw.gpu_pcie_rx_mb!=null&&hw.gpu_pcie_rx_mb<10)?1:0);
      sub2="Gen"+(hw.gpu_pcie_gen_max||hw.gpu_pcie_gen||"?")+(hw.gpu_pcie_width?(" x"+hw.gpu_pcie_width):"")}
    else if(m.key==="cpu"){val=fnum(hw.cpu,0);sub2=st.threads?((st.cores?st.cores+" 核 · ":"")+st.threads+" 线程"):"负载";amax=100}
    else{var rd=hw.disk_read_mb;val=rd==null?"–":fnum(rd,rd<10?1:0);
      sub2=hw.disk_write_mb==null?(st.psutil?"":"需 psutil"):("写 "+fnum(hw.disk_write_mb,1)+" MB/s")}
    tiles.push(std(m,val,m.unit,sub2,amax));
  });
  var ctx=eng.max_context||0,usedNow=0;
  if(state==="reading"||state==="generating")usedNow=(lv.prompt_tokens||0)+(lv.generated||0);
  else if(last)usedNow=(last.prompt_tokens||0)+(last.output_tokens||0);
  var frac=ctx?Math.min(1,usedNow/ctx):0;
  tiles.push('<div class="tile"><div class="lab">上下文填充</div><div class="val">'+Math.round(frac*100)+
    '<small>%</small></div><div class="sub">'+(ctx?(kfmt(usedNow)+" / "+Math.round(ctx/1024)+"K tok"):"–")+'</div>'+
    '<div class="pbar"><i style="width:'+(frac*100).toFixed(1)+'%"></i></div></div>');
  var cacheBytes=(eng.expert_cache_mib||0)*1048576;
  var cacheFrac=(hw.gpu_mem_total&&cacheBytes)?Math.min(1,cacheBytes/hw.gpu_mem_total):0;
  tiles.push('<div class="tile alt"><div class="lab">显存专家缓存</div><div class="val">'+
    (eng.expert_slots!=null?num(eng.expert_slots):"–")+'<small>槽</small></div><div class="sub">'+
    (cacheBytes?(gbf(cacheBytes,1)+" GB · "+Math.round(cacheFrac*100)+"% 显存"):"–")+'</div>'+
    '<div class="pbar warm"><i style="width:'+(cacheFrac*100).toFixed(1)+'%"></i></div></div>');
  var rp=(hw.ram_total&&hw.ram_used!=null)?Math.min(100,100*hw.ram_used/hw.ram_total):0;
  tiles.push('<div class="tile"><div class="lab">系统内存</div><div class="val">'+
    (hw.ram_used!=null?gbf(hw.ram_used,1):"–")+'<small>GB</small></div><div class="sub">'+
    (hw.ram_total?("共 "+gbf(hw.ram_total,0)+" GB · 水位 "+Math.round(rp)+"%"):"–")+'</div>'+
    '<div class="pbar ram'+(rp>92?" hot":"")+'"><i style="width:'+rp.toFixed(1)+'%"></i></div></div>');
  document.getElementById("mon").innerHTML=tiles.join("");
  var dg=document.getElementById("dg-ram"),gg=document.getElementById("dg-gpu");
  if(dg&&hw.ram_total)dg.textContent="DDR4 · "+gbf(hw.ram_total,0)+" GB";
  if(gg){var g0=String(st.gpu_name||"");g0=g0.replace("NVIDIA GeForce ","").replace("NVIDIA ","").replace("GeForce ","");var gn=g0||"GPU";
    gg.textContent=gn+(hw.gpu_mem_total?(" · "+gbf(hw.gpu_mem_total,0)+" GB"):"");}
  
  if(t.requests){
    var pS=t.prompt_ms>0&&readTok>0?(" @ "+fnum(readTok/(t.prompt_ms/1000),0)+" tok/s"):"";
    var oS=t.decode_ms>0&&t.output_tokens>0?(" @ "+fnum(t.output_tokens/(t.decode_ms/1000),1)+" tok/s"):"";
    var since=t.since?new Date(t.since*1000):null;
    var stime=(since&&since.getFullYear()>2020)?((since.getMonth()+1)+"月"+since.getDate()+"日 "+("0"+since.getHours()).slice(-2)+":"+("0"+since.getMinutes()).slice(-2)):"启动";
    strip.innerHTML="自 "+stime+" 起：<b>"+num(t.requests)+"</b> 次请求 · 读取 prompt <b>"+num(readTok)+"</b> tok"+pS+
      "（复用 <b>"+num(t.reused)+"</b>） · 生成 <b>"+num(t.output_tokens)+"</b> tok"+oS;
  }else strip.textContent="本次会话尚无请求——统计从引擎启动起累计";
  var rows=[];
  for(var ri=0;ri<TROWS;ri++){
    var r=requests[ri];
    if(!r){rows.push(phRow());continue}
    var f=FIN[r.finish]||["",r.finish||"–"];
    var hit=r.hit_rate==null?"–":((r.hit_rate*100).toFixed(1)+"%"+
      (r.pcie_share?(' <span style="color:var(--dim)">+'+(r.pcie_share*100).toFixed(1)+"% PCIe</span>"):""));
    var fresh=Math.max(0,(r.prompt_tokens||0)-(r.reused||0));
    var pr=(fresh>0&&r.prompt_ms>0)?fresh/(r.prompt_ms/1000):null;
    rows.push('<tr><td>'+tstr(r.time)+'</td><td><span class="fin '+f[0]+'">'+f[1]+'</span></td>'+
      '<td>'+num(r.prompt_tokens)+'</td><td>'+num(r.reused)+'</td><td>'+num(r.output_tokens)+'</td>'+
      '<td>'+fnum(pr,0)+'</td><td>'+fnum(r.decode_tok_s,1)+'</td><td>'+hit+'</td><td>'+fnum(r.duration_s,1)+"s</td></tr>");
  }
  tb.innerHTML=rows.join("");
  hint.textContent=(d.requests_kept>TROWS)?("留存 "+d.requests_kept+" 条 · 表内显示最近 "+TROWS+" 条"):(requests.length?"":"尚无请求记录——统计从引擎启动起累计");
}
function pollMetrics(){
  if(!selName)return;
  fetch("router/metrics?model="+encodeURIComponent(selName),{headers:hdrs(false)})
    .then(function(r){return r.ok?r.json():Promise.reject(r.status)})
    .then(function(m){mon.data=m;renderMonitor()})
    .catch(function(){mon.data=null;renderMonitor()});
}
[["drawer-sampling","sampling"],["drawer-config","config"]].forEach(function(p){
  var d=document.getElementById(p[0]);if(!d)return;
  try{if(localStorage.getItem("stratagw.drawer."+p[1])==="1")d.open=true}catch(e){}
  d.addEventListener("toggle",function(){
    try{localStorage.setItem("stratagw.drawer."+p[1],d.open?"1":"0")}catch(e){}
  });
});

/* ---------------- settings ---------------- */
var SAMP=[["temperature","stemp","ostemp",1],["top_p","stop_p","os-top_p",2],["top_k","stop_k","os-top_k",0],
          ["reasoning_effort","seffort",null,0],["reasoning_budget_tokens","sbudget",null,0],
          ["seed","sseed",null,0],["max_tokens","smax",null,0],["experimental_speed_projection","sesp",null,0]];
function buildSeg(){
  var seg=document.getElementById("seg-models");seg.innerHTML="";
  modelsList.forEach(function(b){
    var btn=document.createElement("button");
    btn.textContent=metaFor(b.model).nick;
    btn.dataset.model=b.model;
    if(b.model===selName)btn.className="on";
    btn.onclick=function(){selectModel(b.model)};
    seg.appendChild(btn);
  });
}
function selectModel(name,quiet){
  if(selName===name)return;
  selName=name;
  buildSeg();
  mon.data=null;pollMetrics();
  loadSettings();loadConfig();
}
function loadSettings(){
  if(!selName)return;
  qs("router/settings?model="+encodeURIComponent(selName),function(d){
    var def=d.defaults||{};
    SAMP.forEach(function(f){
      var el=document.getElementById(f[1]);var v=def[f[0]];
      if(el.type==="checkbox"){el.checked=!!v}
      else if(el.tagName==="SELECT"){el.value=v==null?"":v}
      else if(el.type==="range"){el.value=(v==null?(f[0]==="temperature"?1:el.value):v);showOut(f)}
      else{el.value=(v==null||v===""?"":v)}
      if(el.type==="range")showOut(f);
    });
  });
}
function showOut(f){var o=f[2];if(!o)return;
  var el=document.getElementById(f[1]);var out=document.getElementById(o);
  if(out)out.textContent=el.value}
document.querySelectorAll(".fgrid input[type=range]").forEach(function(el){
  el.addEventListener("input",function(){
    SAMP.forEach(function(f){if(f[1]===el.id)showOut(f)});
  });
});
document.getElementById("s-save").onclick=function(){
  if(!selName)return;
  var def={};
  SAMP.forEach(function(f){
    var el=document.getElementById(f[1]);var v;
    if(el.type==="checkbox"){if(el.checked)def[f[0]]=true;return}
    v=el.value;
    if(v===""||v==null)return;
    if(el.type==="range"||el.tagName!=="SELECT"&&el.id!=="seffort")v=+v;
    def[f[0]]=v;
  });
  postj("router/settings?model="+encodeURIComponent(selName),{defaults:def},function(rj){
    if(rj[0]>=400){say("保存采样失败 HTTP "+rj[0]+" "+((rj[1].error&&rj[1].error.message)||""),"err");return}
    say("采样默认已保存到 "+selName+"（即时生效）。","");
    if(rj[1].defaults){/* server may normalize; leave form as is */}
  });
};
document.getElementById("s-clear").onclick=function(){
  if(!selName)return;
  postj("router/settings?model="+encodeURIComponent(selName),{defaults:null},function(rj){
    if(rj[0]>=400){say("清除失败 HTTP "+rj[0],"err");return}
    say("已清除："+selName+" 交回各客户端自带的参数。","");
    loadSettings();
  });
};
var cfgKeys=[];
var CFGNOTE="后端 /config 白名单键。保存时 Strata 官方会自动备份配置 json；改动从该模型下次启动起生效。留空 = 删除该键（回默认）。";
function loadConfig(){
  if(!selName)return;
  qs("router/config?model="+encodeURIComponent(selName),function(d){
    cfgKeys=d.keys||[];
    document.getElementById("cfg-note").textContent=(d.note||CFGNOTE)+(d.file?("（文件: "+d.file+"）"):"");
    var wrap=document.getElementById("cfg-list");wrap.innerHTML="";
    cfgKeys.forEach(function(k){
      var row=document.createElement("div");row.className="crow";
      var inputHtml="";
      if(k.kind==="bool"){
        inputHtml='<span class="chk"><input type="checkbox" data-ck="'+esc(k.key)+'"'+(k.value?" checked":"")+'>'+
          '<span>'+(k.value==null?"默认":"")+'</span></span>';
      }else if(k.kind==="enum"){
        inputHtml='<select data-ck="'+esc(k.key)+'"><option value="">默认</option>'+
          (k.choices||[]).map(function(c){return '<option value="'+esc(c)+'"'+(k.value===c?" selected":"")+'>'+esc(c)+'</option>'}).join("")+'</select>';
      }else{
        inputHtml='<input type="text" inputmode="'+(k.kind==="number"?"decimal":"text")+'" data-ck="'+esc(k.key)+'" value="'+(k.value==null?"":esc(String(k.value)))+'" placeholder="默认">';
      }
      row.innerHTML='<span class="ck">'+esc(k.key)+'</span>'+inputHtml+
        '<div class="ch">'+esc(k.help||"")+'</div>';
      wrap.appendChild(row);
    });
  });
}
document.getElementById("c-save").onclick=function(){
  if(!selName)return;
  var set={};
  document.querySelectorAll("#cfg-list [data-ck]").forEach(function(el){
    var key=el.dataset.ck;var v;
    if(el.type==="checkbox"){v=el.checked}
    else if(el.value===""){v=null}
    else if(el.tagName==="SELECT"){v=el.value}
    else{v=/^[0-9.]+$/.test(el.value.trim())?+el.value.trim():el.value.trim()}
    set[key]=v;
  });
  postj("router/config?model="+encodeURIComponent(selName),{set:set},function(rj){
    if(rj[0]>=400){say("保存 Model settings 失败 HTTP "+rj[0]+" "+((rj[1].error&&rj[1].error.message)||""),"err");return}
    var ch=(rj[1].changed||[]);
    say("Model settings 已写入 "+selName+"（"+(ch.length?("改动: "+ch.join(", ")):"无改动")+"）— 下次启动该模型时生效。","busy");
    loadConfig();
  });
};

/* ---------------- about / engine info ---------------- */
function loadInfo(){
  qs("router/info",function(d){
    var b=d.build||{},a=d.app||{},rows=[];
    rows.push(["Strata 本体","v"+String(a.version||"?").replace(/^v/,"")+(a.commit?(" @"+String(a.commit).slice(0,8)):"")]);
    rows.push(["引擎版本",b.version?"v"+b.version:"—"]);
    rows.push(["构建",(b.source||"—")+(b.commit?(" @"+String(b.commit).slice(0,8)):"")]);
    rows.push(["CUDA",(b.cuda||"?")+(b.vision?(" · vision "+b.vision):"")]);
    rows.push(["预编架构",(b.archs||[]).join("/")+" 本机 sm_"+((b.archs||[]).indexOf(86)>=0?"86":"?")]);
    var ms=d.models||{};
    Object.keys(ms).forEach(function(n){
      var m=ms[n];
      rows.push([metaFor(n).nick,m.alive?("上下文 "+Math.round((m.max_context||0)/1024)+"K · vision "+(m.images?"有":"无")+(m.loaded?" · 在位":" · 待命")):"后端离线"]);
    });
    rows.push(["让卡水位",(d.comfy_free_target_mib||0)+" MiB"]);
    document.getElementById("eng-kv").innerHTML=rows.map(function(r){
      return '<span class="kvchip">'+esc(r[0])+'<b>'+esc(String(r[1]))+'</b></span>'}).join("");
  });
}
/* ---------------- dyn ---------------- */
var KIND={load:"载入",unload:"让位",comfy:"显存",switch:"切换",backend:"后端",error:"异常"};
var evOpen=false;
function loadEvents(){
  qs("router/events",function(d){
    var box=document.getElementById("events");
    var raw=(d.events||[]).slice(0,120),evs=[];
    raw.forEach(function(e){var m=evs[evs.length-1];
      if(m&&m.kind===e.kind&&m.text===e.text){m.n++;m.t=e.t}
      else evs.push({kind:e.kind,text:e.text,t:e.t,n:1})});
    var sig=(evOpen?"O":"C")+evs.map(function(e){return e.kind+e.text+e.n+Math.round(e.t)}).join(";");
    if(box.getAttribute("data-sig")===sig)return;
    box.setAttribute("data-sig",sig);
    box.className=evOpen?"open":"";
    box.innerHTML=evs.length?"":"<p style='color:var(--muted);font-size:.8rem'>还没有事件——加载、卸载、让卡都会出现在这里（网关重启前的记录不留存）。</p>";
    (evOpen?evs:evs.slice(0,5)).forEach(function(e,i){
      var p=document.createElement("p");
      p.className="ev "+e.kind;
      p.style.animationDelay=(Math.min(i,10)*0.03)+"s";
      p.innerHTML='<span class="kind">'+(KIND[e.kind]||esc(e.kind))+'</span><time>'+tstr(e.t)+(e.n>1?(' \u00d7'+e.n):"")+'</time><p>'+esc(e.text)+'</p>';
      box.appendChild(p);
    });
    if(evs.length>5){
      var b=document.createElement("button");
      b.className="evbtn";
      b.textContent=evOpen?("收起 · 只留最近 5 条"):("展开其余 "+(evs.length-5)+" 条 ▾");
      b.onclick=function(){evOpen=!evOpen;loadEvents()};
      box.appendChild(b);
    }
  });
}

/* ---------------- comfyui 状态条 + 清理 ---------------- */
var cfree=document.getElementById("cfree"),cforce=document.getElementById("cforce");
var cfreeBusy=null,cfSeen=null;
function sayFree(res){
  var line="显存释放 "+(res.freed_vram_mib/1024).toFixed(1)+" GB · 内存释放 "+(res.freed_ram_mib/1024).toFixed(1)+" GB · 用时 "+res.waited_s+" 秒";
  if(res.force){
    if(res.gave_card)say("强制清理完成，显卡已让出（清掉任务 "+res.tasks_cleared+" 个）。"+line,"");
    else say("强制清理：等了 "+res.waited_s+" 秒显卡还没让出来（任务被打断后可能还在收尾）。"+line,"busy");
  }else{
    if(res.freed_vram_mib>=256)say("温和清理："+line,"");
    else say("温和清理：显存没降——出图任务正在跑不让卡。等它跑完再点，或用强制清理。","busy");
  }
}
function doComfyFree(force){
  if(cfreeBusy)return;
  cfreeBusy={op:force?"force":"gentle"};
  fetch("router/comfy/free",{method:"POST",headers:hdrs(true),body:JSON.stringify({force:force})})
    .then(function(r){return r.json().then(function(j){return[r.status,j]}).catch(function(){return[r.status,{}]})})
    .then(function(rj){
      cfreeBusy=null;
      if(rj[0]>=400||!rj[1].ok){say("清理失败 HTTP "+rj[0]+" "+((rj[1].error&&rj[1].error.message)||""),"err");fetchComfy();return}
      sayFree(rj[1]);
      refresh();
    })
    .catch(function(e){cfreeBusy=null;say("清理请求失败: "+e,"err");fetchComfy()});
}
cfree.onclick=function(){doComfyFree(false)};
cforce.onclick=function(){
  if(confirm("强制清理：会打断正在执行的出图任务并清空排队，然后释放显存。继续吗？"))doComfyFree(true);
};
function fetchComfy(){
  fetch("router/comfy").then(function(r){return r.json()}).then(function(c){
    var el=document.getElementById("comfy"),bar=el.querySelector(".bar i"),lab=el.querySelector("b");
    var fr=null;
    if(cfreeBusy||c.freeing){
      if(!cfSeen)cfSeen=Date.now();
      var extra=Math.floor((Date.now()-cfSeen)/1000);
      if(c.freeing)fr={op:c.freeing.op,elapsed_s:c.freeing.elapsed_s+extra};
      else fr={op:cfreeBusy.op,elapsed_s:extra};
    }else cfSeen=null;
    var busy=!!fr;
    cfree.disabled=!c.running||busy;
    cforce.disabled=!c.running||busy;
    cfree.textContent=(busy&&fr.op==="gentle")?("清理中… "+fr.elapsed_s+"s"):"清理显存";
    cforce.textContent=(busy&&fr.op==="force")?("强清中… "+fr.elapsed_s+"s"):"强制清理";
    cfree.classList.toggle("busy",busy&&fr.op==="gentle");
    cforce.classList.toggle("busy",busy&&fr.op==="force");
    if(!c.running){lab.textContent="未运行";bar.style.width="100%";return}
    var total=c.vram_total_mib||0,free=c.vram_free_mib||0;
    if(total)bar.style.width=Math.round(free/total*100)+"%";
    function g(v){return(v/1024).toFixed(1)+" GiB 空"}
    var st=free>=(c.free_target_mib||0)?"空闲 · ":(busy?"清理中 · ":"出图占用 · ");
    lab.textContent=st+g(free);
  }).catch(function(){});
}

/* ---------------- 本页循环视频：关闭 / 背景 / 单独 ---------------- */
var bgmode="off",bgsound=false,gestured=false;
try{bgmode=localStorage.getItem("stratagw.bgmode")||"off"}catch(e){}
try{bgsound=localStorage.getItem("stratagw.bgsound")==="1"}catch(e){}
if(bgmode!=="bg"&&bgmode!=="solo")bgmode="off";
var stage=document.getElementById("bgstage"),vid=document.getElementById("bgvid"),
    segbg=document.getElementById("seg-bg"),svBtn=document.getElementById("vid-sound");
function playVid(){var p=vid.play();if(p&&p.catch)p.catch(function(){vid.muted=true;
  var q=vid.play();if(q&&q.catch)q.catch(function(){})})}
function paintBg(){
  segbg.querySelectorAll("button").forEach(function(b){b.className=b.dataset.bg===bgmode?"on":""});
  if(bgmode==="off"){vid.pause();stage.className="";stage.setAttribute("aria-hidden","true");
    svBtn.disabled=true;svBtn.textContent="声音: —";return}
  stage.className="on "+bgmode;
  stage.setAttribute("aria-hidden",bgmode==="bg"?"true":"false");
  vid.controls=(bgmode==="solo");
  vid.muted=!(bgsound&&gestured);
  svBtn.disabled=false;svBtn.textContent=bgsound?"声音: 开":"声音: 关";
  playVid()
}
function setBg(m){bgmode=m;try{localStorage.setItem("stratagw.bgmode",m)}catch(e){}paintBg()}
segbg.querySelectorAll("button").forEach(function(b){b.onclick=function(){setBg(b.dataset.bg)}});
svBtn.onclick=function(){if(bgmode==="off")return;bgsound=!bgsound;gestured=true;
  try{localStorage.setItem("stratagw.bgsound",bgsound?"1":"0")}catch(e){}
  vid.muted=!bgsound;svBtn.textContent=bgsound?"声音: 开":"声音: 关"};
stage.addEventListener("click",function(e){if(bgmode==="solo"&&e.target===stage)setBg("off")});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&bgmode==="solo")setBg("off")});
["pointerdown","keydown"].forEach(function(ev){document.addEventListener(ev,function(){
  if(!gestured){gestured=true;if(bgsound&&bgmode!=="off")vid.muted=false}})});
paintBg();

refresh();setInterval(refresh,2000);
setInterval(pollMetrics,2500);
setInterval(loadEvents,5000);loadEvents();
setInterval(loadInfo,10000);loadInfo();

if(!(window.matchMedia&&matchMedia("(prefers-reduced-motion: reduce)").matches)){
  var cv=document.getElementById("fx"),cx=cv.getContext("2d"),P=[],W=0,H=0,DPR=Math.min(window.devicePixelRatio||1,2);
  function size(){W=cv.width=innerWidth*DPR;H=cv.height=innerHeight*DPR;P=[];
    var n=Math.min(70,Math.floor(innerWidth*innerHeight/26000));
    for(var i=0;i<n;i++)P.push({x:Math.random()*W,y:Math.random()*H,
      vx:(Math.random()-.5)*.16*DPR,vy:(Math.random()-.5)*.16*DPR,r:Math.random()*1.6+.5})}
  size();addEventListener("resize",size);
  (function tick(){
    cx.clearRect(0,0,W,H);
    var acc=root.dataset.theme==="light"?"14,116,144":"94,234,212";
    for(var i=0;i<P.length;i++){
      var p=P[i];p.x+=p.vx;p.y+=p.vy;
      if(p.x<0)p.x+=W;if(p.x>W)p.x-=W;if(p.y<0)p.y+=H;if(p.y>H)p.y-=H;
      cx.beginPath();cx.arc(p.x,p.y,p.r*DPR,0,7);
      cx.fillStyle="rgba("+acc+",.5)";cx.fill();
      for(var j=i+1;j<P.length;j++){
        var q=P[j],dx=p.x-q.x,dy=p.y-q.y,d2=dx*dx+dy*dy,L=110*DPR;
        if(d2<L*L){cx.beginPath();cx.moveTo(p.x,p.y);cx.lineTo(q.x,q.y);
          cx.strokeStyle="rgba("+acc+","+(.14*(1-Math.sqrt(d2)/L)).toFixed(3)+")";
          cx.lineWidth=DPR*.6;cx.stroke()}
      }
    }
    requestAnimationFrame(tick);
  })();
}
})();
</script>
</body>
</html>

"""


class Backend:
    def __init__(self, cfg_path: str, cfg: dict, port: int):
        self.cfg_path = cfg_path
        self.name = cfg.get("model_name") or os.path.basename(cfg_path)
        self.aliases = [a for a in (cfg.get("aliases") or []) if isinstance(a, str)]
        self.key = cfg.get("api_key", "")
        self.port = port
        self.last_spawn = 0.0
        self.proc: subprocess.Popen | None = None

    @property
    def base(self) -> str:
        return f"http://127.0.0.1:{self.port}"

    def matches(self, model: str) -> bool:
        return model in (self.name, *self.aliases)

    def alive(self) -> bool:
        try:
            with OPENER.open(f"{self.base}/health", timeout=3):
                return True
        except HTTPError as e:
            return e.code in (401, 403)          # the API is up; it only wants the key
        except (URLError, OSError):
            return False

    def resident(self) -> bool | None:
        """True/False: is the model loaded; None: the backend is down or slow."""
        try:
            req = urlrequest.Request(
                f"{self.base}/v1/models",
                headers={"Authorization": f"Bearer {self.key}"} if self.key else {})
            with OPENER.open(req, timeout=5) as r:
                data = (json.loads(r.read() or b"{}") or {}).get("data") or []
        except (URLError, OSError, ValueError):
            return None
        for m in data:
            if m.get("id") == self.name:
                return ((m.get("status") or {}).get("value")) == "loaded"
        return False

    def spawn(self) -> None:
        lock = _spawn_locks.setdefault(self.cfg_path, threading.Lock())
        if not lock.acquire(blocking=False):
            return                               # another thread is spawning it
        try:
            if self.alive():
                return
            if time.time() - self.last_spawn < SPAWN_COOLDOWN_S:
                return
            self.last_spawn = time.time()
            if not os.path.isfile(PYTHON) or not os.path.isfile(SERVER_PY):
                print(f"[router] cannot spawn {self.name}: python/server.py missing", flush=True)
                return
            # Foreground child: the backend shares this console, so its startup
            # narrator and [strata] lines stream into the same window as the
            # router's. winjob.contain ties it (and its engine, vision encoder,
            # everything it starts later) to this process's lifetime: whatever
            # ends the router - Ctrl+C, the window's X, taskkill, a crash - the
            # job's kill-on-close takes the whole tree with it.
            self.proc = subprocess.Popen(
                [PYTHON, SERVER_PY, "--engine", "strata", "--config", self.cfg_path,
                 "--host", "0.0.0.0", "--port", str(self.port),
                 "--api-key", self.key, "--lazy"],
                cwd=ROOT, stdin=subprocess.DEVNULL)
            try:
                from serve import winjob
                winjob.contain(self.proc)
            except Exception:
                pass
            print(f"[router] spawned {self.name} on :{self.port} (lazy)", flush=True)
            revent("backend", f"{self.name} backend process started on :{self.port}")
        finally:
            lock.release()

    def wait_alive(self, timeout: float) -> bool:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if self.alive():
                return True
            time.sleep(2.0)
        return False

    def unload(self, timeout: float = 60.0) -> None:
        """Best effort: stop the engine to free RAM/VRAM. busy (409) is fine here:
        the load's own min_free_vram check + the router's retry catch it."""
        try:
            req = urlrequest.Request(
                f"{self.base}/unload", method="POST",
                headers={"Content-Type": "application/json",
                         "Authorization": f"Bearer {self.key}"}, data=b"{}")
            with OPENER.open(req, timeout=timeout) as r:
                print(f"[router] unload {self.name}: {r.status} {r.read()[:120]!r}", flush=True)
        except HTTPError as e:
            print(f"[router] unload {self.name}: HTTP {e.code}", flush=True)
        except (URLError, OSError) as e:
            print(f"[router] unload {self.name}: {e}", flush=True)
        invalidate_resident()
        note_intentional(self.name)


def scan_configs() -> dict[str, Backend]:
    """strata-*.json next to this file -> backends. Ports: a config's own port
    (when it is not the router's) wins, else the saved mapping, else the next
    free 1808x. The mapping is persisted so restarts keep the same ports."""
    saved: dict[str, int] = {}
    try:
        with open(PORTS_FILE, encoding="utf-8") as f:
            saved = {k: int(v) for k, v in (json.load(f) or {}).items()}
    except (OSError, ValueError):
        pass
    taken = {ROUTER_PORT}
    backends: dict[str, Backend] = {}
    entries = []
    for path in sorted(glob.glob(os.path.join(ROOT, "strata-*.json"))):
        base = os.path.basename(path)
        if re.search(r"\.bak|\.tmp|\.log", base):
            continue
        try:
            with open(path, encoding="utf-8-sig") as f:
                cfg = json.load(f)
            if not isinstance(cfg, dict) or not cfg.get("model_name"):
                continue
        except (OSError, ValueError) as e:
            print(f"[router] skipping {base}: {e}", flush=True)
            continue
        entries.append((path, cfg))
    for path, cfg in sorted(entries, key=lambda x: x[1]["model_name"]):
        name = cfg["model_name"]
        port = saved.get(name)
        own = cfg.get("port")
        if not port and isinstance(own, int) and own not in taken and own != ROUTER_PORT:
            port = own
        if not port:
            port = FIRST_BACKEND_PORT
            while port in taken:
                port += 1
        taken.add(port)
        backends[path] = Backend(path, cfg, port)
    with _lock:
        new_saved = {b.name: b.port for b in backends.values()}
        if new_saved != saved:
            try:
                with open(PORTS_FILE, "w", encoding="utf-8") as f:
                    json.dump(new_saved, f, indent=1)
            except OSError as e:
                print(f"[router] cannot save {PORTS_FILE}: {e}", flush=True)
    return backends


BACKENDS: dict[str, Backend] = {}


_resident_cache: dict[str, tuple[float, bool | None]] = {}


def resident_of(b: "Backend") -> bool | None:
    """b.resident() with a short cache: the webUI polls /metrics every second,
    and each answer costs a backend round trip."""
    now = time.monotonic()
    hit = _resident_cache.get(b.cfg_path)
    if hit is not None and now - hit[0] < RESIDENT_TTL_S:
        return hit[1]
    r = b.resident()
    _resident_cache[b.cfg_path] = (now, r)
    return r


class ComfyNotFree(Exception):
    """ComfyUI was asked to free its models but has not given the card back
    within the wait window (a generation task usually has to finish first)."""


def comfy_vram_free_mib() -> int | None:
    """Global free VRAM as ComfyUI itself sees it (torch mem_get_info via
    /system_stats); None when unreadable."""
    try:
        with OPENER.open(f"{COMFY_URL}/system_stats", timeout=COMFY_FREE_TIMEOUT_S) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
        devs = data.get("devices") or []
        if not devs:
            return None
        v = devs[0].get("vram_free")
        return None if v is None else int(int(v) >> 20)
    except (HTTPError, URLError, OSError, ValueError, TypeError):
        return None


def comfy_unload(wait: bool = True) -> bool:
    """Ask a running ComfyUI to drop its models so the card is really free.
    /free sets flags ComfyUI's prompt worker consumes at once when idle (the
    idle worker's get() wakes on set_flag's notify) - but after a long task it
    has only set the flag; the unload (VRAM *and* the model's RAM) lands
    seconds later, or minutes later when a task is still running. So: best
    effort send, then wait for the card to actually come back (the canvas
    'free memory' button blocks exactly the same way, which is why freeing by
    hand first makes a Strata load fast again). True = free to load;
    False = ComfyUI still holds the card after COMFY_FREE_WAIT_S."""
    try:
        req = urlrequest.Request(
            f"{COMFY_URL}/free", method="POST",
            headers={"Content-Type": "application/json"},
            data=json.dumps({"unload_models": True, "free_memory": True}).encode())
        with OPENER.open(req, timeout=COMFY_FREE_TIMEOUT_S):
            print("[router] asked ComfyUI to free its models", flush=True)
    except (HTTPError, URLError, OSError) as e:
        print(f"[router] ComfyUI /free skipped: {e}", flush=True)
        return True                      # no ComfyUI running: nothing to wait for
    if not wait:
        return True
    free = comfy_vram_free_mib()
    if free is None:
        print("[router] ComfyUI VRAM is unreadable; loading without the free-card wait",
              flush=True)
        return True
    deadline = time.time() + COMFY_FREE_WAIT_S
    while free is not None and free < COMFY_FREE_TARGET_MIB:
        if time.time() >= deadline:
            print(f"[router] ComfyUI has not given the card back in {COMFY_FREE_WAIT_S:g} s "
                  f"({free} MiB free, want {COMFY_FREE_TARGET_MIB}); not loading", flush=True)
            return False
        time.sleep(1.0)
        free = comfy_vram_free_mib()
    print(f"[router] ComfyUI gave the card back ({free} MiB free)", flush=True)
    return True


_preferred: dict = {"name": None}       # 最近一次用户点名加载/卸载的模型（粘性）


def invalidate_resident() -> None:
    """状态刚被改变（load/unload/换装）: 丢掉 3s 驻留缓存，让跟随即时生效。"""
    _resident_cache.clear()


def set_preferred(name: str | None) -> None:
    if _preferred["name"] != name:
        _preferred["name"] = name
        print(f"[router] preferred model: {name}", flush=True)
        revent("switch", "preferred model: " + str(name))


def preferred_backend() -> "Backend | None":
    name = _preferred["name"]
    if not name:
        return None
    return next((b for b in BACKENDS.values() if b.name == name), None)


def any_resident() -> bool:
    return any(resident_of(b) is True for b in BACKENDS.values())


GENTLE_FREE_WAIT_S = 8.0      # the canvas button's evidence window; force uses COMFY_FREE_WAIT_S


def _comfy_probe() -> "dict | None":
    """VRAM/RAM as ComfyUI itself reports it; None when unreachable."""
    try:
        with OPENER.open(f"{COMFY_URL}/system_stats", timeout=COMFY_FREE_TIMEOUT_S) as r:
            data = json.loads(r.read().decode("utf-8", "replace"))
        dev = (data.get("devices") or [{}])[0]
        total = int(dev.get("vram_total") or 0) >> 20
        free = int(dev.get("vram_free") or 0) >> 20
        ram_used = int(((data.get("system") or {}).get("ram_used")) or 0) >> 20
        return {"vram_total_mib": total, "vram_used_mib": total - free,
                "vram_free_mib": free, "ram_used_mib": ram_used}
    except (HTTPError, URLError, OSError, ValueError, TypeError):
        return None


def comfy_stats() -> dict:
    """网关页 ComfyUI 状态条数据（含清理进行态：刷新页面也能接着转圈）。"""
    out = {"running": False, "vram_total_mib": None, "vram_free_mib": None,
           "free_target_mib": COMFY_FREE_TARGET_MIB, "freeing": None}
    if _comfy_free:
        out["freeing"] = {"op": _comfy_free.get("op"),
                          "elapsed_s": int(time.time() - _comfy_free.get("since", time.time()))}
    p = _comfy_probe()
    if p is not None:
        out.update({"running": True, "vram_total_mib": p["vram_total_mib"] or None,
                    "vram_free_mib": p["vram_free_mib"]})
    return out


def comfy_interrupt_and_clear() -> int:
    """强制清理第一步：清空排队项 + 打断正在跑的任务（ComfyUI 核心 API，
    和画布网关的 cancel 路径同款）。返回动过的任务数。"""
    pending: list = []
    running = 0
    try:
        with OPENER.open(f"{COMFY_URL}/queue", timeout=COMFY_FREE_TIMEOUT_S) as r:
            q = json.loads(r.read().decode("utf-8", "replace"))
        pending = [row[0] for row in (q.get("queue_pending") or [])
                   if isinstance(row, list) and row and row[0]]
        running = len(q.get("queue_running") or [])
    except (HTTPError, URLError, OSError, ValueError, TypeError):
        pass
    if pending:
        try:
            req = urlrequest.Request(f"{COMFY_URL}/queue", method="POST",
                                     headers={"Content-Type": "application/json"},
                                     data=json.dumps({"delete": pending}).encode())
            with OPENER.open(req, timeout=COMFY_FREE_TIMEOUT_S):
                pass
        except (HTTPError, URLError, OSError):
            pass
    try:
        req = urlrequest.Request(f"{COMFY_URL}/interrupt", method="POST",
                                 headers={"Content-Type": "application/json"}, data=b"{}")
        with OPENER.open(req, timeout=COMFY_FREE_TIMEOUT_S):
            pass
    except (HTTPError, URLError, OSError):
        pass
    return len(pending) + running


_comfy_free: dict = {}        # 控制台清理进行态 {"op","since"}：按钮转圈以它为准


def comfy_free_console(force: bool) -> "dict | None":
    """控制台的「清理显存」按钮。
    温和 = 画布同款语义: 只 POST /free，轮询最多 GENTLE_FREE_WAIT_S，看显存读数是否真降
    （≥256 MiB 即认账；读数纹丝不动两次就提前收手，别白等）；绝不打断在跑的任务。
    强制 = 先 interrupt + 清队列，再 /free，用和 Load 放卡同一个等待窗与水位
    （COMFY_FREE_WAIT_S / COMFY_FREE_TARGET_MIB）确证卡已让出。None = ComfyUI 不可达。"""
    before = _comfy_probe()
    if before is None:
        return None
    t0 = time.time()
    _comfy_free["op"] = "force" if force else "gentle"
    _comfy_free["since"] = t0
    try:
        cleared = comfy_interrupt_and_clear() if force else 0
        try:
            req = urlrequest.Request(f"{COMFY_URL}/free", method="POST",
                                     headers={"Content-Type": "application/json"},
                                     data=json.dumps({"unload_models": True,
                                                      "free_memory": True}).encode())
            with OPENER.open(req, timeout=COMFY_FREE_TIMEOUT_S):
                pass
        except (HTTPError, URLError, OSError):
            pass                        # best effort; the measuring loop below judges anyway
        after = before
        last = before["vram_used_mib"]
        stable = 0
        while time.time() - t0 < (COMFY_FREE_WAIT_S if force else GENTLE_FREE_WAIT_S):
            time.sleep(0.3)
            probe = _comfy_probe()
            if probe is None:
                break
            after = probe
            if force:
                if after["vram_free_mib"] >= COMFY_FREE_TARGET_MIB:
                    break
            else:
                if before["vram_used_mib"] - after["vram_used_mib"] >= 256:
                    break               # the canvas button's 'freed' evidence
                stable = stable + 1 if abs(after["vram_used_mib"] - last) <= 8 else 0
                last = after["vram_used_mib"]
                if stable >= 2 and time.time() - t0 >= 0.9:
                    break               # numbers moved twice: nothing is coming, stop early
    finally:
        _comfy_free.clear()
    freed_gb = max(0, before["vram_used_mib"] - after["vram_used_mib"]) / 1024.0
    gave = after["vram_free_mib"] >= COMFY_FREE_TARGET_MIB
    revent("comfy", ("force" if force else "gentle") + " free: " +
           "%.1f GB 显存已释放，用时 %d 秒" % (freed_gb, int(time.time() - t0)) +
           ("，显卡已让出" if gave else "，尚未让出") +
           ("（清掉 %d 个任务）" % cleared if force and cleared else ""))
    return {"ok": True, "force": force,
            "freed_vram_mib": max(0, before["vram_used_mib"] - after["vram_used_mib"]),
            "freed_ram_mib": max(0, before["ram_used_mib"] - after["ram_used_mib"]),
            "waited_s": int(time.time() - t0),
            "tasks_cleared": cleared if force else 0,
            "gave_card": gave}


_busy: dict[str, dict] = {}    # model -> {"op","since"}: an in-flight load/unload.
                               # The gateway console draws its ring progress from here,
                               # so refreshing the page mid-load keeps the timer going.


def set_busy(name: str, op: str) -> None:
    _busy[name] = {"op": op, "since": time.time()}


def clear_busy(name: str) -> None:
    _busy.pop(name, None)


def busy_info(name: str):
    b = _busy.get(name)
    if not b:
        return None
    return {"op": b["op"], "elapsed_s": int(time.time() - b["since"])}


def default_backend() -> Backend | None:
    """无 model 字段请求的跟随顺序: 先跟驻留的模型（About/Monitor 说的是正在跑的引擎），
    再跟用户最近点选的模型（webUI 的 Load 按钮不再只能加载名字序第一档），
    最后回落名字序第一。"""
    ranked = sorted(BACKENDS.values(), key=lambda x: x.name)
    for b in ranked:
        if resident_of(b) is True:
            return b
    pref = preferred_backend()
    if pref is not None and pref.alive():
        return pref
    return next(iter(ranked), None)


def pick_backend(model: str | None) -> Backend | None:
    if model:
        for b in sorted(BACKENDS.values(), key=lambda x: x.name):
            if b.matches(model):
                return b
    return default_backend()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"                # close per response; SSE streams fine
    server_version = "strata-router/1"

    def log_message(self, fmt, *args):           # quieter default log
        pass

    # ---- helpers -------------------------------------------------------
    def _auth(self) -> str:
        return self.headers.get("Authorization", "")

    def _read_body(self) -> bytes:
        if (self.headers.get("Transfer-Encoding") or "").lower().endswith("chunked"):
            body = bytearray()
            while True:
                line = self.rfile.readline(65536).strip()
                size = int(line.split(b";")[0], 16)
                if size:
                    body += self.rfile.read(size)
                    self.rfile.read(2)           # CRLF
                else:
                    self.rfile.readline()
                    break
                if len(body) > (256 << 20):
                    break
            return bytes(body)
        length = int(self.headers.get("Content-Length", "0") or 0)
        return self.rfile.read(length) if length else b""

    def _cors_headers(self) -> None:
        """Browser pages (ST extensions) call /v1/* cross-origin; without these the browser blocks."""
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Authorization, Content-Type, x-api-key, anthropic-version, anthropic-beta")
        self.send_header("Access-Control-Max-Age", "600")

    def _send(self, status: int, body: bytes, ctype: str = "application/json") -> None:
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self._cors_headers()
        self.end_headers()
        self.wfile.write(body)

    def _json(self, status: int, obj) -> None:
        self._send(status, json.dumps(obj, ensure_ascii=False).encode())

    def _forward_raw(self, backend: Backend, method: str, path_qs: str, body: bytes,
                     extra_timeout: float = 900.0) -> int:
        """Stream the backend's answer through, byte for byte."""
        headers = {"Content-Type": self.headers.get("Content-Type", "application/json")}
        if self._auth():
            headers["Authorization"] = self._auth()
        req = urlrequest.Request(backend.base + path_qs, data=body if body else None,
                                 headers=headers, method=method)
        try:
            resp = OPENER.open(req, timeout=extra_timeout)
        except HTTPError as e:
            resp = e                              # pass the backend's status/body through
        except (URLError, OSError) as e:
            self._json(502, {"error": {"message": f"backend {backend.name} unreachable: {e}"}})
            return 502
        with resp:
            status = resp.code
            self.send_response(status)
            ctype = resp.headers.get("Content-Type", "application/json")
            self.send_header("Content-Type", ctype)
            self._cors_headers()
            self.end_headers()
            try:
                while True:
                    chunk = resp.read(8192)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except (ConnectionResetError, BrokenPipeError):
                pass                              # the client went away mid-stream
            return status

    def _forward_html(self, backend: Backend, path_qs: str) -> None:
        """GET a webUI HTML page, buffer it, inject the unload-watcher before </body>
        (marker check guards double injection), answer with a corrected length."""
        headers = {"Content-Type": self.headers.get("Content-Type", "text/html")}
        if self._auth():
            headers["Authorization"] = self._auth()
        req = urlrequest.Request(backend.base + path_qs, headers=headers, method="GET")
        try:
            resp = OPENER.open(req, timeout=15)
        except HTTPError as e:
            resp = e
        except (URLError, OSError) as e:
            self._json(502, {"error": {"message": f"backend {backend.name} unreachable: {e}"}})
            return
        with resp:
            status = resp.code
            ctype = resp.headers.get("Content-Type", "text/html")
            try:
                body = resp.read()
            except (ConnectionResetError, OSError):
                body = b""
            if status == 200 and "text/html" in ctype and b"strataGatewayWatch" not in body:
                inject = WATCH_JS.encode("utf-8")
                i = body.rfind(b"</body>")
                body = (body[:i] + inject + body[i:]) if i >= 0 else (body + inject)
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self._cors_headers()
            self.end_headers()
            try:
                self.wfile.write(body)
            except (ConnectionResetError, BrokenPipeError):
                pass

    # ---- routing -------------------------------------------------------
    def _models_all(self) -> None:
        out = []
        for b in sorted(BACKENDS.values(), key=lambda x: x.name):
            try:
                req = urlrequest.Request(f"{b.base}/v1/models",
                                         headers={"Authorization": self._auth()} if self._auth() else {})
                with OPENER.open(req, timeout=8) as r:
                    out.extend(json.loads(r.read() or b"{}").get("data") or [])
            except HTTPError as e:
                if e.code in (401, 403):          # the backend is up and wants the key: pass it on
                    body = e.read()
                    return self._send(e.code, body)
                b.spawn()                         # down: (re)start it, it lists itself when up
            except (URLError, OSError, ValueError):
                b.spawn()                         # down: (re)start it, it lists itself when up
        self._json(200, {"object": "list", "data": out,
                         "router": {"service": "strata-router", "port": ROUTER_PORT}})

    def _health_all(self) -> None:
        backends = []
        for b in sorted(BACKENDS.values(), key=lambda x: x.name):
            alive = b.alive()
            if not alive:
                b.spawn()
            backends.append({"model": b.name, "port": b.port, "alive": alive,
                             "loaded": b.resident() if alive else None,
                             "busy": busy_info(b.name)})
        self._json(200, {"status": "ok", "service": "strata-router", "port": ROUTER_PORT,
                         "backends": backends})

    def _prepare_load(self, target: Backend) -> None:
        """The target is not resident: free the machine for it, then wait for its
        API (a freshly spawned lazy backend binds within seconds or so)."""
        if not target.alive():
            target.spawn()
            if not target.wait_alive(LOAD_WAIT_S):
                raise RuntimeError(f"backend {target.name} did not come up on :{target.port}")
        if target.resident() is not True:            # None (fresh spawn) counts as "about to load"
            for b in sorted(BACKENDS.values(), key=lambda x: x.name):
                if b is not target and b.alive():
                    b.unload()
            if not comfy_unload():
                raise ComfyNotFree(f"ComfyUI still holds the GPU ({COMFY_FREE_WAIT_S:g} s "
                                   "after POST /free): a generation task may still be running")

    def _route(self, method: str) -> None:
        if method == "OPTIONS":                # CORS preflight: answer here, no backend roundtrip
            self.send_response(204)
            self._cors_headers()
            self.end_headers()
            return
        parsed = self.path.split("?", 1)
        path, qs = (parsed + [""])[0].rstrip("/") or "/", (parsed + ["", ""])[1]
        if method == "GET" and path in ("/v1/models", "/models"):
            return self._models_all()
        if method == "GET" and path in ("/health", "/api/health"):
            return self._health_all()
        if method == "GET" and path == "/gateway":
            return self._send(200, GATEWAY_HTML.encode("utf-8"), "text/html; charset=utf-8")
        if method == "GET" and path == "/router/backends":
            return self._health_all()
        if method == "GET" and path == "/router/comfy":
            return self._json(200, comfy_stats())
        if method == "GET" and path == "/router/events":
            return self._json(200, {"events": [{"t": t, "kind": k, "text": x}
                                               for t, k, x in reversed(list(_EVENTS))]})
        if method == "GET" and path == "/router/log":
            n = 200
            m2 = re.search(r"(?:^|&)n=([0-9]+)", qs)
            if m2:
                n = max(0, min(500, int(m2.group(1))))
            return self._json(200, {"lines": [[t, line] for t, line in list(_LOG)[-n:]]})
        if method == "GET" and path == "/router/info":
            return self._json(200, router_info())
        if method == "GET" and path.startswith("/router/assets/"):
            # Static art + loop video for the console. Range + ETag so a <video>
            # streams properly and revalidation after the master swaps a file is
            # a 304 instead of a re-download.
            name = unquote(path[len("/router/assets/"):])
            if not ASSET_NAME.match(name):
                return self._json(404, {"error": {"message": "no such asset"}})
            p = os.path.join(ROOT, "gw-assets", name)
            try:
                size = os.path.getsize(p)
                etag = '"%s-%x-%x"' % (name, size, int(os.path.getmtime(p)))
            except OSError:
                return self._json(404, {"error": {"message": "no such asset"}})
            if self.headers.get("If-None-Match") == etag:
                self.send_response(304)
                self.send_header("ETag", etag)
                self.end_headers()
                return
            ext = name.rsplit(".", 1)[-1].lower()
            ctype = {"png": "image/png", "webp": "image/webp", "jpg": "image/jpeg",
                     "jpeg": "image/jpeg", "mp4": "video/mp4", "webm": "video/webm"}[ext]
            lo, hi, status = 0, size - 1, 200
            rng = (self.headers.get("Range") or "").strip()
            m = re.match(r"bytes=(\d*)-(\d*)$", rng) if rng else None
            if m and size:
                a, b = m.group(1), m.group(2)
                if a:
                    lo, hi = int(a), (int(b) if b else size - 1)
                    hi = min(hi, size - 1)
                    if lo >= size or lo > hi:
                        self.send_response(416)
                        self.send_header("Content-Range", "bytes */%d" % size)
                        self.end_headers()
                        return
                else:
                    lo = max(0, size - (int(b) if b else size))
                status = 206
            try:
                with open(p, "rb") as f:
                    f.seek(lo)
                    data = f.read(hi - lo + 1)
            except OSError:
                return self._json(404, {"error": {"message": "no such asset"}})
            self.send_response(status)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Cache-Control", "no-cache")   # 主人换素材后刷新即见
            self.send_header("ETag", etag)
            if status == 206:
                self.send_header("Content-Range", "bytes %d-%d/%d" % (lo, hi, size))
            self.end_headers()
            try:
                self.wfile.write(data)
            except (ConnectionResetError, BrokenPipeError):
                pass
            return
        if method == "GET" and path in ("/", "/monitor"):
            if not any_resident():
                self.send_response(302)
                self.send_header("Location", "/gateway")
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            return self._forward_html(pick_backend(None), self.path)
        body = self._read_body() if method == "POST" else b""
        if method == "POST" and path == "/router/comfy/free":
            force = False
            if body:
                try:
                    jj = json.loads(body)
                    force = bool(isinstance(jj, dict) and jj.get("force"))
                except ValueError:
                    pass
            res = comfy_free_console(force)
            if res is None:
                return self._json(503, {"error": {"message": "ComfyUI 当前不可达（没在跑？）"}})
            return self._json(200, res)
        model = None
        if body:
            try:
                req = json.loads(body)
                if isinstance(req, dict):
                    model = req.get("model") if isinstance(req.get("model"), str) else None
            except ValueError:
                pass
        if not model and qs:
            m = re.search(r"(?:^|&)model=([^&]+)", qs)
            if m:
                model = m.group(1)
        backend = pick_backend(model)
        if backend is None:
            return self._json(503, {"error": {"message": "no strata-*.json configs found"}})
        if path.startswith("/router/"):
            if method in ("GET", "POST") and path in PROXY_PATHS:
                return self._forward_raw(backend, method, path[len("/router"):], body)
            return self._json(404, {"error": {"message": "unknown router endpoint"}})
        if method == "POST" and path in GEN_PATHS:
            pre_res = backend.resident()
            set_busy(backend.name, "load")       # a harness-triggered cold load shows
            try:                                  # on the console too, ring and all
                try:
                    self._prepare_load(backend)
                except ComfyNotFree as e:
                    return self._json(503, {"error": {"message": str(e) + "; let the task finish, press the canvas "
                                                      "\u6e05\u7406\u663e\u5b58\u5185\u5b58 button, or retry"}},
                                      headers={"Retry-After": "15"})
                except RuntimeError as e:
                    return self._json(502, {"error": {"message": str(e)}})
                if pre_res is not True:
                    revent("load", f"{backend.name} cold-loaded for a harness request")
                    note_intentional(backend.name)
                for attempt in range(6):          # the other model's unload may still be in flight
                    status = self._forward_raw(backend, method, self.path, body)
                    if status != 503 or attempt == 5:
                        return
                    if backend.resident() is not True:
                        for b in sorted(BACKENDS.values(), key=lambda x: x.name):
                            if b is not backend and b.alive():
                                b.unload()
                        comfy_unload(wait=False)  # already waited once; just re-poke
                        time.sleep(5.0)
                    else:
                        return
                return
            finally:
                clear_busy(backend.name)
        if method == "POST" and path in ("/load", "/unload"):
            op = "load" if path == "/load" else "unload"
            set_busy(backend.name, op)            # visible on /router/backends until done
            pre_res = backend.resident() is True  # bridge re-pokes /unload while nothing is
            t0 = time.time()                      # resident: only a real move deserves an event
            try:
                if op == "load":
                    try:
                        self._prepare_load(backend)   # spawn 目标 + 卸其它模型 + 等 ComfyUI 放卡
                    except ComfyNotFree as e:
                        revent("error", f"{backend.name} load blocked: ComfyUI kept the card")
                        return self._json(503, {"error": {"message": str(e)}},
                                          headers={"Retry-After": "15"})
                    except RuntimeError as e:
                        revent("error", f"{backend.name} load blocked: {e}")
                        return self._json(502, {"error": {"message": str(e)}})
                set_preferred(backend.name)
                invalidate_resident()
                status = self._forward_raw(backend, method, self.path, body)
                note_intentional(backend.name)
                if status < 400:
                    now_res = backend.resident() is True
                    if op == "load" and not pre_res and now_res:
                        revent("load", f"{backend.name} loaded via the console in {int(time.time() - t0)} s")
                    elif op == "unload" and pre_res and not now_res:
                        revent("unload", f"{backend.name} unloaded via the console")
                return status
            finally:
                clear_busy(backend.name)
        return self._forward_raw(backend, method, self.path, body)

    def do_GET(self):
        self._route("GET")

    def do_POST(self):
        self._route("POST")

    def do_OPTIONS(self):
        self._route("OPTIONS")


def cleanup() -> None:
    """Stop the backend children. The winjob job is the real guarantee (it fires
    however this process ends); this just makes an ordinary exit tidier."""
    for b in list(BACKENDS.values()):
        p = b.proc
        if p is not None and p.poll() is None:
            try:
                p.terminate()
            except OSError:
                pass


def main() -> None:
    global BACKENDS
    if os.name != "nt" and not os.environ.get("STRATA_ROUTER_ANYHOST"):
        print(f"[router] note: designed for the Strata box (Windows); running on "
              f"{sys.platform}", flush=True)
    BACKENDS = scan_configs()
    if not BACKENDS:
        print(f"[router] no strata-*.json in {ROOT}; nothing to serve", flush=True)
        sys.exit(1)

    def on_close(signum, frame):                # the console window's X button
        cleanup()
        os._exit(0)

    if os.name == "nt":
        import signal
        try:
            signal.signal(signal.SIGBREAK, on_close)
        except (ValueError, OSError):
            pass
    for b in BACKENDS.values():
        if not b.alive():
            b.spawn()
    threading.Thread(target=_watchdog, daemon=True).start()
    httpd = ThreadingHTTPServer(("0.0.0.0", ROUTER_PORT), Handler)
    httpd.daemon_threads = True
    names = ", ".join(f"{b.name}(:{b.port})" for b in sorted(BACKENDS.values(), key=lambda x: x.name))
    print(f"[router] ready on :{ROUTER_PORT}  models: {names}", flush=True)
    print(f"[router] default model: {default_backend().name}", flush=True)
    print("[router] Ctrl+C or close this window to stop the gateway and the engines", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        cleanup()


if __name__ == "__main__":
    main()
